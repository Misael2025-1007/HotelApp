@model List<PisoDto>
@{
    ViewData["Title"] = "Pisos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Gestión de pisos</h2>
    <a class="btn btn-primary" asp-action="Create">Nuevo piso</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr><th>Hotel</th><th>Bloque</th><th>Piso</th><th>Estado</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.HotelNombre</td>
                <td>@(p.BloqueNombre ?? "—")</td>
                <td>@p.Numero</td>
                <td><span class="badge @(p.Status ? "bg-success" : "bg-secondary")">@(p.Status ? "Activo" : "Inactivo")</span></td>
                <td>@await Html.PartialAsync("_RowActions", new RowActionsModel(p.Id, p.Status, "Pisos"))</td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="5" class="text-center text-muted">No hay pisos registrados.</td></tr>
        }
        </tbody>
    </table>
</div>
