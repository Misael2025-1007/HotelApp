@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center mb-4">
    <h1 class="display-5">HotelApp</h1>
    <p class="text-muted">Gestión de la estructura del hotel</p>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title">Hoteles</h5>
            <p class="card-text">Registro y mantenimiento de hoteles.</p>
            <a class="btn btn-primary" asp-controller="Hoteles" asp-action="Index">Abrir</a>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title">Bloques</h5>
            <p class="card-text">Bloques o edificios de cada hotel.</p>
            <a class="btn btn-primary" asp-controller="Bloques" asp-action="Index">Abrir</a>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title">Pisos</h5>
            <p class="card-text">Pisos por hotel y bloque.</p>
            <a class="btn btn-primary" asp-controller="Pisos" asp-action="Index">Abrir</a>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title">Habitaciones</h5>
            <p class="card-text">Habitaciones, tarifas y estados.</p>
            <a class="btn btn-primary" asp-controller="Habitaciones" asp-action="Index">Abrir</a>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title">Tipos de habitación</h5>
            <p class="card-text">Catálogo de tipos de habitación.</p>
            <a class="btn btn-primary" asp-controller="TiposHabitacion" asp-action="Index">Abrir</a>
        </div></div>
    </div>
</div>
