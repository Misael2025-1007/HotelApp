@model List<TipoHabitacionDto>
@{
    ViewData["Title"] = "Tipos de habitación";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Tipos de habitación</h2>
    <a class="btn btn-primary" asp-action="Create">Nuevo tipo</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr><th>Nombre</th><th>Descripción</th><th>Estado</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.Nombre</td>
                <td>@t.Descripcion</td>
                <td><span class="badge @(t.Status ? "bg-success" : "bg-secondary")">@(t.Status ? "Activo" : "Inactivo")</span></td>
                <td>@await Html.PartialAsync("_RowActions", new RowActionsModel(t.Id, t.Status, "TiposHabitacion"))</td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="4" class="text-center text-muted">No hay tipos de habitación registrados.</td></tr>
        }
        </tbody>
    </table>
</div>
