@model List<HabitacionDto>
@{
    ViewData["Title"] = "Habitaciones";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Gestión de habitaciones</h2>
    <a class="btn btn-primary" asp-action="Create">Nueva habitación</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Hotel</th><th>Piso</th><th>Número</th><th>Tipo</th>
                <th class="text-end">Capacidad</th><th class="text-end">Tarifa</th>
                <th>Disponibilidad</th><th>Estado</th><th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var h in Model)
        {
            <tr>
                <td>@h.HotelNombre</td>
                <td>@h.PisoNumero</td>
                <td>@h.Numero</td>
                <td>@h.TipoNombre</td>
                <td class="text-end">@h.Capacidad</td>
                <td class="text-end">@h.Tarifa.ToString("N2")</td>
                <td><span class="badge @EstadoHelper.Clase(h.Estado)">@EstadoHelper.Texto(h.Estado)</span></td>
                <td><span class="badge @(h.Status ? "bg-success" : "bg-secondary")">@(h.Status ? "Activa" : "Inactiva")</span></td>
                <td>@await Html.PartialAsync("_RowActions", new RowActionsModel(h.Id, h.Status, "Habitaciones"))</td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="9" class="text-center text-muted">No hay habitaciones registradas.</td></tr>
        }
        </tbody>
    </table>
</div>
