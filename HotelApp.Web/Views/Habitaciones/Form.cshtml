@model UpdateHabitacionDto
@{
    ViewData["Title"] = Model.Id == 0 ? "Nueva habitación" : "Editar habitación";
    var pisos = (List<SelectListItem>)ViewBag.Pisos;
    var tipos = (List<SelectListItem>)ViewBag.Tipos;
    var estados = (List<SelectListItem>)ViewBag.Estados;
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Guardar" method="post" class="col-md-7">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="PisoId" class="form-label">Piso</label>
        <select asp-for="PisoId" asp-items="pisos" class="form-select">
            <option value="0">-- Seleccione un piso --</option>
        </select>
        <span asp-validation-for="PisoId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TipoHabitacionId" class="form-label">Tipo de habitación</label>
        <select asp-for="TipoHabitacionId" asp-items="tipos" class="form-select">
            <option value="0">-- Seleccione un tipo --</option>
        </select>
        <span asp-validation-for="TipoHabitacionId" class="text-danger"></span>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Numero" class="form-label">Número</label>
            <input asp-for="Numero" class="form-control" />
            <span asp-validation-for="Numero" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Capacidad" class="form-label">Capacidad</label>
            <input asp-for="Capacidad" type="number" min="1" max="20" class="form-control" />
            <span asp-validation-for="Capacidad" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Tarifa" class="form-label">Tarifa</label>
            <input asp-for="Tarifa" type="number" step="0.01" min="0.01" class="form-control" />
            <span asp-validation-for="Tarifa" class="text-danger"></span>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Estado" class="form-label">Estado</label>
        <select asp-for="Estado" asp-items="estados" class="form-select"></select>
        <span asp-validation-for="Estado" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
